# Server Configuration
PORT=8080
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma & PG Pool)
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"

# Google Gemini AI API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# Schema Caching & Database Function Settings
STORED_FUNCTION_NAME="get_database_schema"
CACHE_NAME="schemaMetadata"
CACHE_KEY="databaseSchema"
CACHE_TTL_HOURS=6
FETCH_ON_STARTUP=true

# PostgreSQL LISTEN/NOTIFY Realtime Settings
NOTIFICATION_ENABLED=true
NOTIFICATION_CHANNEL="schema_changed"
NOTIFICATION_DEBOUNCE_MS=1000
NOTIFICATION_RECONNECT_MS=5000
